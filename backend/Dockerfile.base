FROM python:3.11-slim-trixie AS base

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_COMPILE=1 \
    PIP_NO_CACHE_DIR=1

COPY config/requirements_base.txt config/constraints.txt ./

RUN set -eux; \
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*; do \
        if [ -f "$f" ]; then sed -i 's|http://deb.debian.org|https://deb.debian.org|g' "$f"; fi; \
    done; \
    apt-get update; \
    apt-get install -y --no-install-recommends libhdf5-dev; \
    pip install --no-compile --no-cache-dir -c constraints.txt -r requirements_base.txt; \
    SP="$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')"; \
    find "$SP" -name "*.a" -delete; \
    find "$SP" -type d \( -name "__pycache__" -o -name "tests" -o -name "test" \) -prune -exec rm -rf {} + 2>/dev/null || true; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /usr/share/doc/* /usr/share/man/*

EXPOSE 8000

FROM base AS dev

COPY config/requirements_base_dev.txt ./

RUN set -eux; \
    pip install --no-compile --no-cache-dir \
        -c constraints.txt -r requirements_base_dev.txt
